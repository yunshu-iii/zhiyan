# Fill provider keys locally. Never commit .env.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash
POSTGRES_DSN=
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=zhiyan_memory
MILVUS_KNOWLEDGE_COLLECTION=zhiyan_knowledge
USER_ID=user01
TENANT_ID=default_tenant
MAX_ITERATIONS=3
ENABLE_MEMORY=true
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
CHECKPOINTER_BACKEND=postgres
ENABLE_MILVUS=true
APP_ENV=production
HOST=127.0.0.1
PORT=8000
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NO_COLOR=1
